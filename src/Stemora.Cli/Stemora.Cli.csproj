<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.4.0</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>stemora</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Stemora.Core\Stemora.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Content Include="..\..\artifacts\native\*.exe;..\..\artifacts\native\*.dll;..\..\artifacts\native\*.json"
             Link="native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
