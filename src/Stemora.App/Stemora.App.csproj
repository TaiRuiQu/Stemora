<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.3.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Stemora.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Stemora.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <ProjectReference Include="..\Stemora.Core\Stemora.Core.csproj" />
  </ItemGroup>
  <ItemGroup><Content Include="Assets\Stemora.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- Unpackaged publish must explicitly carry the compiled app XAML, not only the WinUI runtime. -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_AppXamlResources Include="$(OutDir)**\*.xbf" />
      <_AppXamlResources Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
      <ResolvedFileToPublish Include="@(_AppXamlResources)">
        <RelativePath>%(_AppXamlResources.RecursiveDir)%(_AppXamlResources.Filename)%(_AppXamlResources.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="'@(_AppXamlResources)' == ''" Text="Compiled WinUI resources were not generated." />
  </Target>
</Project>
