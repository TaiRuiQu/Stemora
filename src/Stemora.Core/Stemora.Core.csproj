<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.4.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <EmbeddedResource Include="Data\models.json" />
    <EmbeddedResource Include="Data\Piano\*.pcm.gz" WithCulture="false" LogicalName="Stemora.Core.Data.Piano.%(Filename)%(Extension)" />
    <None Include="..\..\licenses\Salamander-Grand-Piano.txt" Link="licenses\Salamander-Grand-Piano.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data\en-US.json" />
    <EmbeddedResource Include="Data\muscriptor_bridge.py" />
  </ItemGroup>
</Project>
